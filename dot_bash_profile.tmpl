# ~/.bash_profile — login shells (terminal tabs on macOS, `bash -l`, agents).
# Environment only: anything a script or an LLM agent needs goes here.
# Interactive niceties live in ~/.bashrc.
#
# Speed rule: no subprocesses here. Tool output that never changes
# (`brew shellenv`, `mise activate --shims`) is written out inline.

{{- if eq .chezmoi.os "darwin" }}

# Homebrew (inlined `brew shellenv bash`)
export HOMEBREW_PREFIX=/opt/homebrew
export HOMEBREW_CELLAR=/opt/homebrew/Cellar
export HOMEBREW_REPOSITORY=/opt/homebrew
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
export HOMEBREW_AUTO_UPDATE_SECS=86400
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_INSTALL_CLEANUP=1

# Silence macOS "default interactive shell is now zsh" notice
export BASH_SILENCE_DEPRECATION_WARNING=1
export PNPM_HOME="$HOME/Library/pnpm"
{{- else }}

if [[ -d /home/linuxbrew/.linuxbrew ]]; then
  export HOMEBREW_PREFIX=/home/linuxbrew/.linuxbrew
  export HOMEBREW_CELLAR=$HOMEBREW_PREFIX/Cellar
  export HOMEBREW_REPOSITORY=$HOMEBREW_PREFIX/Homebrew
  export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin${PATH+:$PATH}"
fi
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}

export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LESS='-R -F -i'   # keep colors, quit if one screen, smart-case search

# PATH (later entries win). mise shims put node, python, … on PATH for every
# shell, interactive or not, with no per-prompt hook.
export GOPATH="$HOME/go"
export BUN_INSTALL="$HOME/.bun"
# Tool installers that edit shell rc files (cargo, Docker, turso, …) are listed
# here instead; each entry is skipped when its directory doesn't exist.
for d in "$HOME/.docker/bin" "$HOME/.sdkman/candidates/java/current/bin" "$HOME/.cargo/bin" \
         "$HOME/.turso" "$HOME/.antigravity/antigravity/bin" "$HOME/.antigravity-ide/antigravity-ide/bin" \
         "$HOME/.minimax-code/bin" "$HOME/.mavis/bin" "$HOME/.omlx/bin" \
         "$GOPATH/bin" "$HOME/.luarocks/bin" "$PNPM_HOME" "$BUN_INSTALL/bin" \
         "${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims" "$HOME/bin" "$HOME/.local/bin"; do
  [[ -d $d && ":$PATH:" != *":$d:"* ]] && PATH="$d:$PATH"
done
unset d
export PATH

# 1Password SSH agent for tools that read SSH_AUTH_SOCK (ssh itself uses ~/.ssh/config)
{{- if eq .chezmoi.os "darwin" }}
_op_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else }}
_op_sock="$HOME/.1password/agent.sock"
{{- end }}
[[ -S $_op_sock ]] && export SSH_AUTH_SOCK=$_op_sock
unset _op_sock

# Machine-specific environment that must not be public (internal hosts, local
# experiments). Not managed by chezmoi; never commit it.
[[ -r ~/.bash_profile.local ]] && . ~/.bash_profile.local

[[ -r ~/.bashrc ]] && . ~/.bashrc
