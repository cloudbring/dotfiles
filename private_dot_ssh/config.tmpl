# Keys live in 1Password; its SSH agent serves them (Touch ID per app session).
#
# ssh uses the first value it finds for each option, so the local files below
# win over everything in this file. Neither is managed by chezmoi or committed:
#   fleet.conf    written by cloudbring/fleet on unattended machines; pins
#                 github.com and fleet hosts to an on-disk key with no agent,
#                 so agents never wait for a fingerprint.
#   config.local  home-lab and work hosts (internal names and addresses).
# A missing Include file is ignored.
Include ~/.ssh/fleet.conf
Include ~/.ssh/config.local
{{- if eq .chezmoi.os "darwin" }}
Include ~/.colima/ssh_config
{{- end }}

# Pin GitHub to the "Git SSH key" item. The .pub file tells the 1Password
# agent which key to offer; the private key never leaves 1Password.
Host github.com
    User git
    IdentityFile ~/.ssh/git_ssh_key.pub
    IdentitiesOnly yes

Host *
{{- if eq .chezmoi.os "darwin" }}
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else }}
    IdentityAgent ~/.1password/agent.sock
{{- end }}
    AddKeysToAgent no
    ServerAliveInterval 60
