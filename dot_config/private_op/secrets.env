# Secret references for `opx` (op run). Values never touch disk or shell history:
# `opx CMD…` resolves these from 1Password for that one command only.
# Format: NAME=op://vault/item/field (field label or ID; IDs survive renames).
# Find IDs: op item get ITEM --format json | jq '.fields[] | {label, id}'

# OpenAI › "Default Secret Key"
OPENAI_API_KEY=op://Personal/OpenAI/7ytdru6nrh37qv7q5hyuov4q7i
# OpenRouter › "sk"
OPENROUTER_API_KEY=op://Personal/OpenRouter/password

# Keys the agents' MCP servers and nvim also need as plain environment
# variables; on slab those exports live in the untracked ~/.bash_profile.local.
# Context7 › "claude-code"
CONTEXT7_API_KEY=op://Personal/Context7/xva6nlalmycvq4jbpuhnikxxgq
# Exa API Key › "credential"
EXA_API_KEY=op://Personal/khiy4qtt5s2g6r5dzjodyaljde/credential
# Firecrawl API Key › "credential"
FIRECRAWL_API_KEY=op://Personal/smkzzaggaaa3eiqaspo4vflcj4/credential
# Gemini API Key (slab shell) › "credential"
GEMINI_API_KEY=op://Personal/yrdn5oww2qyzx5f67vso6ytoj4/credential
