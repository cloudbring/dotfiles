[user]
	email = emmanuelm@gmail.com
	name = Emmanuel Mwangi
{{- /* Fleet machines (cloudbring/fleet) sign with their on-disk key so
       unattended agents never wait for 1Password; others use 1Password. */}}
{{- $fleetKey := joinPath .chezmoi.homeDir ".ssh/id_ed25519_fleet.pub" }}
{{- if stat $fleetKey }}
	signingkey = {{ trimSuffix ".pub" $fleetKey }}
[gpg]
	format = ssh
[gpg "ssh"]
	program = ssh-keygen
{{- else if .git.signingkey }}
	signingkey = {{ .git.signingkey }}
[gpg]
	format = ssh
[gpg "ssh"]
{{- if eq .chezmoi.os "darwin" }}
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- else }}
	program = /opt/1Password/op-ssh-sign
{{- end }}
{{- end }}
{{- if or (stat $fleetKey) .git.signingkey }}
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- end }}
[github]
	user = cloudbring
{{- with lookPath "gh" }}
# HTTPS remotes authenticate through the GitHub CLI's stored login.
[credential "https://github.com"]
	helper =
	helper = !{{ . }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ . }} auth git-credential
{{- end }}
[init]
	defaultBranch = master
[core]
	autocrlf = false
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rerere]
	enabled = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
